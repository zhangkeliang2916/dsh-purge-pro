{
  "name": "dsh-purge",
  "version": "1.1.72-dsh022rc1.1",
  "description": "DeepSeek Harness 破甲 Pro：以 1.1.72 为基座，适配 DSH 0.2.2-rc.1，保留红队演练台、随包 Skill、知识库及 Windows/Kali SSH 适配。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": "./client.js",
    "./redteam": "./lib/redteam/index.js",
    "./redteam/store": "./lib/redteam/store.js",
    "./redteam/ui": "./lib/redteam/ui.js",
    "./redteam/tools": "./lib/redteam/tools.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "dsh-purge": "bin/dsh-purge.js"
  },
  "files": [
    "lib",
    "!lib/default-prompt-inject.md",
    "bin",
    "docs",
    "presets",
    "skills",
    "scripts",
    "client.js",
    "cordis.patch.yml",
    "screenshots.json",
    "README.md",
    "README.zh-CN.md",
    "README.en.md",
    "LICENSE"
  ],
  "scripts": {
    "embed-prompt": "node scripts/embed-default-prompt.mjs",
    "build:client": "node scripts/build-client.mjs",
    "postinstall": "node scripts/ensure-profile-bundle.mjs"
  },
  "license": "MIT",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "dsh-plugins",
    "网络安全",
    "红队评测",
    "llm-security",
    "harness-security",
    "deepseek-harness",
    "red-team",
    "instructions",
    "rules",
    "prompt-eval",
    "agent"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zhangkeliang2916/dsh-purge-pro.git"
  },
  "homepage": "https://github.com/zhangkeliang2916/dsh-purge-pro#readme",
  "bugs": {
    "url": "https://github.com/zhangkeliang2916/dsh-purge-pro/issues"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    },
    "install": {
      "preferred": "zip",
      "zip": "https://github.com/zhangkeliang2916/dsh-purge-pro/archive/refs/heads/dsh-desktop-maintenance-20261028.zip",
      "git": "https://github.com/zhangkeliang2916/dsh-purge-pro.git"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "engines": {
    "node": ">=18"
  },
  "dshTarget": "0.2.2-rc.1",
  "contributors": [
    {
      "name": "小杨 (YuJunZhiXue)",
      "url": "https://github.com/YuJunZhiXue/dsh-purge"
    },
    {
      "name": "evilevil",
      "url": "https://github.com/evilevil"
    }
  ]
}
